# =====================================================================
# Production environment for the Tibia Atlas API (VPS + Cloudflare).
# Copy to `.env` on the server and fill in the secrets. NEVER commit the
# real .env. Generate APP_KEY with: php artisan key:generate
# =====================================================================

APP_NAME="Tibia Atlas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false                 # MUST be false in prod (no stack traces leak)
APP_URL=https://api.tibiaatlas.example

# Base host for public assets — the mirrored entry sprites written by
# tibia:mirror-images are served from {MEDIA_URL}/storage. Leave unset to reuse
# APP_URL (the API host, behind Cloudflare). Set it only to serve media from a
# separate CDN/subdomain. It is baked into entries.primary_image at mirror time.
# MEDIA_URL=https://api.tibiaatlas.example

# Behind Cloudflare the real client IP arrives in a header; trust the proxy so
# rate limiting + logging see the visitor, not Cloudflare's edge IP.
# (Configure trusted proxies in bootstrap/app.php — see DEPLOY.md.)

LOG_CHANNEL=stack
LOG_LEVEL=warning               # info/debug are noisy + costly under load

# ---- Database (PostgreSQL, ideally via PgBouncer on :6432) ----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=6432
DB_DATABASE=tibia_atlas
DB_USERNAME=tibia_atlas
DB_PASSWORD=

# ---- Redis: cache + sessions + queue (the whole point of a serious setup) ----
REDIS_CLIENT=phpredis           # install ext-redis; faster than predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=                 # set a password; bind redis to localhost
REDIS_PORT=6379

CACHE_STORE=redis               # was `database` in dev — Redis under load
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true            # session payloads encrypted at rest in Redis

# ---- Telescope: dashboard is CLOSED outside local unless your IP is here ----
# (nginx Basic Auth is the outer layer; this in-app gate is the inner one.)
TELESCOPE_ALLOWED_IPS=          # e.g. 203.0.113.7,203.0.113.8

QUEUE_CONNECTION=redis          # view-counting + imports run off-request

# ---- CORS: restrict the API to your real frontend origin ----
FRONTEND_URL=https://tibiaatlas.example
